<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>報名</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#22305F; --paper:#F4F6FB; --card:#fff; --lamp:#E8A43A; --lamp-soft:#FCEFD3;
    --slate:#566180; --line:#D6DBE9; --danger:#B3382C; --ok:#2E7D5B; --warn:#8A5A00;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:#1B2238;
    font:16px/1.6 "Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;-webkit-text-size-adjust:100%}
  .wrap{max-width:560px;margin:0 auto;padding:0 16px}
  .top{background:var(--ink);color:#fff;padding:22px 0 20px}
  .top h1{margin:0;font-size:26px;line-height:1.25;font-weight:700;letter-spacing:.02em}
  .top p{margin:6px 0 0;color:#C9D1EC;font-size:14px}
  main{padding-top:16px;padding-bottom:40px}
  h2{font-size:17px;margin:0 0 10px;font-weight:700}
  h3{font-size:15.5px;margin:0 0 6px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px 16px;margin-bottom:14px}
  label{display:block;font-weight:600;font-size:15px;margin:16px 0 4px}
  .grid2 label{margin-top:0}
  input,select,textarea{width:100%;font:inherit;padding:11px 12px;border:1px solid #B8C0D6;border-radius:8px;background:#fff;color:inherit;min-height:46px}
  input[type=checkbox]{width:22px;height:22px;min-height:0;flex:0 0 auto;margin:3px 0 0}
  textarea{min-height:76px;resize:vertical}
  :focus-visible{outline:3px solid var(--lamp);outline-offset:2px}
  .btn{font:inherit;font-weight:700;min-height:48px;padding:0 20px;border-radius:10px;border:0;cursor:pointer}
  .btn.primary{background:var(--ink);color:#fff;width:100%;margin-top:18px;font-size:17px}
  .btn.add{background:#fff;color:var(--ink);border:1.5px solid var(--ink);width:100%;margin-top:10px}
  .btn.danger{background:#fff;color:var(--danger);border:1.5px solid var(--danger);width:100%;margin-top:10px}
  .btn.danger.armed{background:var(--danger);color:#fff}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .link{background:none;border:0;font:inherit;color:var(--ink);text-decoration:underline;padding:8px 4px;min-height:40px;cursor:pointer}
  a{color:var(--ink)}
  .muted{color:var(--slate)} .small{font-size:13.5px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .who{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:8px}
  .tools{display:flex;gap:8px;flex-wrap:wrap}
  #banner{padding:12px 14px;border-radius:8px;margin-bottom:12px;font-weight:600}
  #banner.ok{background:#DDF0E6;color:#1F5C41}
  #banner.error{background:#FBE3DF;color:#8C2A20}
  .rules p{margin:0 0 6px}
  .rules h3{margin:14px 0 6px;color:var(--ink)}
  .rules h3:first-child{margin-top:0}
  .agree{display:flex;gap:10px;align-items:flex-start;font-weight:600;margin:16px 0 0}
  .phase{margin-top:12px;padding:10px 12px;border-radius:8px;background:#EEF1F8;font-weight:600}
  .phase.ok{background:#DDF0E6;color:#1F5C41}
  .phase.closed{background:#FBE9D0;color:#7A4B00}
  .box{margin-top:18px;padding:12px;border:1.5px dashed #AEB7D1;border-radius:10px}
  .codebox{font-size:34px;font-weight:700;letter-spacing:.2em;text-align:center;padding:12px;border-radius:10px;background:var(--lamp-soft);border:2px solid var(--lamp);font-variant-numeric:tabular-nums}
  .tchips{display:flex;flex-wrap:wrap;gap:8px}
  .tchip{min-height:44px;padding:0 14px;border-radius:99px;font:inherit;font-weight:600;font-size:15px;cursor:pointer;background:#fff;color:var(--ink);border:1.5px solid #AEB7D1}
  .tchip[aria-pressed="true"]{background:var(--lamp-soft);border:2px solid var(--lamp);font-weight:700}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
  .dchip{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:99px;background:var(--lamp-soft);border:1.5px solid var(--lamp);color:var(--ink);font:inherit;font-weight:700;font-size:15px;cursor:pointer}
  .strip{display:flex;align-items:stretch;margin:6px 0 6px}
  .gap{flex:0 0 2px;margin:0 4px;background:repeating-linear-gradient(to bottom,#AEB7D1 0 4px,transparent 4px 8px)}
  .slot{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:space-between;gap:6px;min-height:104px;padding:12px 6px;border:2px solid var(--ink);border-radius:6px;background:var(--ink);color:#fff;text-align:center;font:inherit;cursor:pointer}
  .s-name{font-weight:700;font-size:16px}
  .s-time{font-size:12.5px;font-variant-numeric:tabular-nums}
  .s-state{font-size:15px;font-weight:700;border-top:1px solid rgba(255,255,255,.35);padding-top:6px}
  .slot[aria-pressed="true"]{background:repeating-linear-gradient(135deg,var(--lamp-soft) 0 7px,#F6D58F 7px 14px);border-color:var(--lamp);color:var(--ink)}
  .slot[aria-pressed="true"] .s-state{border-top-color:rgba(34,48,95,.35)}
  .summary{margin:14px 0 0;padding:10px 12px;border-left:4px solid var(--lamp);background:var(--lamp-soft);border-radius:0 8px 8px 0;font-weight:600}
  .seg{display:flex;gap:8px}
  .seg button{flex:1 1 0;min-width:0;min-height:62px;padding:8px 4px;border-radius:8px;font:inherit;cursor:pointer;background:#fff;color:var(--ink);border:2px solid var(--ink);display:flex;flex-direction:column;justify-content:center;gap:2px}
  .seg .n{font-weight:700;font-size:16px} .seg .t{font-size:12px;font-variant-numeric:tabular-nums}
  .seg button[aria-pressed="true"]{background:var(--ink);color:#fff}
  .tabs{display:flex;gap:6px;margin-bottom:12px}
  .tabs button{flex:1 1 0;min-height:46px;border-radius:10px;font:inherit;font-weight:700;cursor:pointer;background:#fff;color:var(--ink);border:1.5px solid #AEB7D1}
  .tabs button[aria-selected="true"]{background:var(--ink);color:#fff;border-color:var(--ink)}
  #preview{margin-top:8px}
  .pv{padding:8px 10px;border-radius:8px;margin-top:6px;background:#EEF1F8;font-weight:600}
  .pv .note{display:block;font-weight:400;font-size:13.5px;margin-top:2px;color:var(--warn)}
  .pv.bad{background:#FBE3DF;color:#8C2A20}
  .pv.hot{background:#FBE3DF}
  .row{padding:12px 0;border-top:1px solid var(--line)}
  .row:first-child{border-top:0;padding-top:0}
  .row .a{font-weight:700} .row .b{font-size:14px;color:var(--slate)}
  .row.off .a,.row.off .b{text-decoration:line-through}
  .row .st{font-size:13.5px;margin-top:2px} .row .st.good{color:var(--ok)} .row .st.bad{color:var(--danger)}
  .rowtop{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
  .chip{display:inline-block;font-size:12.5px;font-weight:700;padding:1px 8px;border-radius:99px;background:#DDF0E6;color:var(--ok);margin-left:6px;vertical-align:1px;text-decoration:none}
  .chip.off{background:#E8EAF1;color:var(--slate)}
  .chip.hot{background:#FBE3DF;color:var(--danger)}
  .undo,.cancel{flex:0 0 auto;min-height:40px;padding:0 14px;border-radius:8px;font:inherit;font-weight:700;font-size:14px;background:#fff;color:var(--ink);border:1.5px solid var(--ink);cursor:pointer}
  .undo.armed,.cancel.armed{background:var(--danger);border-color:var(--danger);color:#fff}
  details{margin-top:6px} summary{cursor:pointer;color:var(--ink);font-weight:600}
  .sub{margin-top:8px;padding-left:10px;border-left:3px solid var(--line);font-size:14px}
  [hidden]{display:none !important}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <h1 id="title">報名</h1>
  <p id="phaseTop">載入中…</p>
  <div id="periods"></div>
</div></header>

<main class="wrap">
  <div id="banner" hidden></div>

  <section class="card" id="rulesCard">
    <h2>報名辦法及公約</h2>
    <div id="rules" class="rules"><p class="muted">載入中…</p></div>
    <label class="agree"><input type="checkbox" id="agree"><span>我已閱讀並同意以上報名辦法及公約</span></label>
    <div id="phaseBox" class="phase" hidden></div>
    <button class="btn primary" id="startBtn" type="button" disabled>報名 / 加退選</button>
    <p class="muted small" style="margin:12px 0 0">已經報名、要請假的家長,請到 <a href="leave/">請假頁面</a>。</p>
  </section>

  <section class="card" id="formCard" hidden>
    <h2>學生與家長資料</h2>
    <p class="muted small" id="modeNote" style="margin:0 0 6px"></p>
    <div class="grid2">
      <div><label for="cls">班級</label><input id="cls" type="text" autocomplete="off" placeholder="例如 901"></div>
      <div><label for="seat">座號</label><input id="seat" type="text" inputmode="numeric" autocomplete="off" placeholder="例如 7"></div>
    </div>
    <label for="name">學生姓名</label>
    <input id="name" type="text" autocomplete="off">

    <label>自習天數(可複選)</label>
    <div class="tchips" id="days" role="group" aria-label="自習天數"></div>

    <label for="parents">家長姓名</label>
    <input id="parents" type="text" autocomplete="off" placeholder="一位:王大明;兩位:王大明/林美麗">
    <label for="phones">聯絡電話</label>
    <input id="phones" type="text" inputmode="tel" autocomplete="off" placeholder="一位:0912345678;兩位:0912345678/0933111222">
    <label for="emails">Email(通知請假及違規用)</label>
    <input id="emails" type="text" inputmode="email" autocomplete="off" autocapitalize="off" placeholder="一個或兩個,兩個請用 / 分隔">
    <label for="note">備註(選填)</label>
    <textarea id="note" maxlength="100"></textarea>

    <div class="box">
      <h3>已經報名過、要加退選?</h3>
      <p class="muted small" style="margin:0 0 6px">請填上面的班級、座號、姓名,再輸入報名時取得的驗證碼。新報名的同學不用填。</p>
      <label for="code" style="margin-top:8px">驗證碼</label>
      <input id="code" type="text" inputmode="numeric" autocomplete="off" placeholder="6 位數字">
      <div class="tools">
        <button class="btn add" id="loadBtn" type="button" style="flex:1">載入我的報名資料</button>
        <button class="link" id="resendBtn" type="button">忘記驗證碼?寄到報名信箱</button>
      </div>
    </div>

    <button class="btn primary" id="submitBtn" type="button">檢查並送出</button>
    <button class="btn danger" id="withdrawBtn" type="button">全部退選(退出自習)</button>
  </section>

  <section class="card" id="reviewCard" hidden>
    <h2>送出前請再檢查一次</h2>
    <div id="reviewBody"></div>
    <p class="muted small">送出後會寄確認信到你填寫的信箱。</p>
    <button class="btn primary" id="confirmBtn" type="button">確認無誤,送出</button>
    <button class="btn add" id="backBtn" type="button">回去修改</button>
  </section>

  <section class="card" id="doneCard" hidden>
    <h2 id="doneTitle">完成</h2>
    <div id="doneBody"></div>
    <button class="btn add" id="againBtn" type="button">再報名另一位學生</button>
    <p class="muted small" style="margin:12px 0 0">要請假,請到 <a href="leave/">請假頁面</a>。</p>
  </section>
</main>

<script>
(function () {
  // ★★ 把下面這行換成 Apps Script「管理部署作業」裡的網頁應用程式網址(結尾是 /exec)
  var API_URL = 'PASTE_YOUR_EXEC_URL_HERE';

  var $ = function (id) { return document.getElementById(id); };
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  // 用 text/plain 送出,瀏覽器就不會多送一次預檢請求(Apps Script 不支援預檢)
  function post(body) {
    if (!API_URL || API_URL.indexOf('/exec') < 0) return Promise.reject(new Error('尚未設定 API_URL'));
    return fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(body) })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
  }
  function showBanner(kind, msg) {
    var b = $('banner'); b.className = kind; b.textContent = msg; b.hidden = false;
    b.setAttribute('role', kind === 'error' ? 'alert' : 'status'); b.scrollIntoView({ block: 'nearest' });
  }
  function clearBanner() { $('banner').hidden = true; }
  function setBusy(on) { Array.prototype.forEach.call(document.querySelectorAll('.btn.primary'), function (b) { b.disabled = on; }); }
  function run(body, ok) {
    setBusy(true);
    post(body).then(function (res) { setBusy(false); ok(res); })
      .catch(function (e) { setBusy(false); showBanner('error', '系統暫時無法使用,請稍後再試。'); console.error(e); });
  }
  // 兩段式確認按鈕:第一次按變紅,4 秒內再按一次才執行
  function twoStep(btn, label, armedLabel, fn) {
    btn.addEventListener('click', function () {
      if (!btn.dataset.armed) {
        btn.dataset.armed = '1'; btn.textContent = armedLabel; btn.classList.add('armed');
        setTimeout(function () { if (btn.isConnected) { delete btn.dataset.armed; btn.textContent = label; btn.classList.remove('armed'); } }, 4000);
        return;
      }
      delete btn.dataset.armed; btn.textContent = label; btn.classList.remove('armed'); fn();
    });
  }

  var info = null, daySel = {};

  function renderRules(list) {
    var box = $('rules'); box.innerHTML = '';
    if (!list.length) { box.appendChild(el('p', 'muted', '(尚未設定報名辦法)')); return; }
    list.forEach(function (r) { box.appendChild(el(r.t === 'h' ? 'h3' : 'p', '', r.text)); });
  }
  function updateStart() { $('startBtn').disabled = !(info && info.phase.open && $('agree').checked); }

  post({ action: 'info' }).then(function (res) {
    if (!res.ok) throw new Error(res.msg);
    info = res;
    $('title').textContent = res.name + ' 報名';
    document.title = res.name + ' 報名';
    $('phaseTop').textContent = res.phase.open ? res.phase.label + '開放中' : '目前未開放報名';
    var pe = $('periods'); pe.innerHTML = ''; (res.periods || []).forEach(function (t) { pe.appendChild(el('p', '', t)); });
    renderRules(res.rules);
    var pb = $('phaseBox'); pb.hidden = false; pb.textContent = res.phase.msg; pb.className = 'phase ' + (res.phase.open ? 'ok' : 'closed');
    var box = $('days'); box.innerHTML = '';
    res.days.forEach(function (d) {
      var b = el('button', 'tchip', d.label); b.type = 'button'; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () { daySel[d.n] = !daySel[d.n]; b.setAttribute('aria-pressed', daySel[d.n] ? 'true' : 'false'); });
      b.dataset.n = d.n; box.appendChild(b);
    });
    var change = res.phase.mode === 'change';
    $('modeNote').textContent = change
      ? '已錄取的同學要改天數或退選,送出後進入每週統一處理(預定次週一生效),不會立即生效;加報名要視座位狀況。只改聯絡資料會立即更新。'
      : '截止前可以用驗證碼重複修改,以最後送出的資料為準。';
    if (change) { $('startBtn').textContent = '申請異動 / 加報名'; $('submitBtn').textContent = '檢查並送出申請'; }
    updateStart();
  }).catch(function (e) { $('phaseTop').textContent = ''; showBanner('error', '系統暫時無法使用,請稍後再試。'); console.error(e); });

  $('agree').addEventListener('change', updateStart);
  $('startBtn').addEventListener('click', function () {
    clearBanner(); $('formCard').hidden = false; $('formCard').scrollIntoView({ block: 'start' });
  });

  function setDays(list) {
    daySel = {};
    list.forEach(function (n) { daySel[n] = true; });
    Array.prototype.forEach.call($('days').children, function (b) { b.setAttribute('aria-pressed', daySel[b.dataset.n] ? 'true' : 'false'); });
  }
  function val(id) { return $(id).value.trim(); }
  function chosenDays() { return info.days.filter(function (d) { return daySel[d.n]; }).map(function (d) { return d.n; }); }
  function who() { return { cls: val('cls'), seat: val('seat'), name: val('name') }; }

  $('loadBtn').addEventListener('click', function () {
    clearBanner();
    var w = who();
    if (!w.cls || !w.seat || !w.name || !val('code')) { showBanner('error', '請先填班級、座號、姓名和驗證碼。'); return; }
    run({ action: 'signup_load', cls: w.cls, seat: w.seat, name: w.name, code: val('code') }, function (res) {
      if (!res.ok) { showBanner('error', res.msg); return; }
      setDays(res.days); $('parents').value = res.parents; $('phones').value = res.phones; $('emails').value = res.emails; $('note').value = res.note;
      showBanner('ok', '目前狀態:' + res.status + '。已載入你的報名資料,修改後按「檢查並送出」。' + (res.pending ? ' 你有一筆處理中的申請:' + res.pending : ''));
    });
  });

  $('resendBtn').addEventListener('click', function () {
    clearBanner();
    var w = who();
    if (!w.cls || !w.seat || !w.name) { showBanner('error', '請先填班級、座號、姓名。'); return; }
    run({ action: 'signup_resend', cls: w.cls, seat: w.seat, name: w.name }, function (res) {
      showBanner(res.ok ? 'ok' : 'error', res.ok ? res.msg : res.msg);
    });
  });

  var pending = null;
  function showDone(title, res, w) {
    var body = $('doneBody'); body.innerHTML = '';
    $('doneTitle').textContent = title;
    body.appendChild(el('p', '', w.cls + ' ' + w.seat + '號 ' + w.name + (res.daysText ? ',自習天數:' + res.daysText : '')));
    if (res.message) body.appendChild(el('p', '', res.message));
    if (res.code) {
      body.appendChild(el('p', 'muted', '這是你的驗證碼,請截圖或抄下來。修改資料、異動申請與請假都要用:'));
      body.appendChild(el('div', 'codebox', res.code));
    }
    if (res.mailed !== undefined) body.appendChild(el('p', 'muted small', res.mailed ? '確認信已寄到你填寫的信箱,沒收到請看垃圾信件匣。' : '確認信沒有寄出(' + res.mailText + '),' + (res.code ? '請務必先記下驗證碼。' : '請聯絡老師。')));
    ['formCard', 'reviewCard', 'rulesCard'].forEach(function (id) { $(id).hidden = true; });
    $('doneCard').hidden = false; window.scrollTo(0, 0);
  }

  $('submitBtn').addEventListener('click', function () {
    clearBanner();
    var w = who(), days = chosenDays();
    if (!w.cls) { showBanner('error', '請填寫班級。'); return; }
    if (!w.seat) { showBanner('error', '請填寫座號。'); return; }
    if (!w.name) { showBanner('error', '請填寫學生姓名。'); return; }
    if (!days.length) { showBanner('error', '請至少選擇一天自習。要退出請按最下面的「全部退選」。'); return; }
    if (!val('parents')) { showBanner('error', '請填寫家長姓名。'); return; }
    if (!val('phones')) { showBanner('error', '請填寫聯絡電話。'); return; }
    if (!val('emails')) { showBanner('error', '請填寫 Email(通知請假及違規用)。'); return; }
    pending = { action: 'signup_submit', cls: w.cls, seat: w.seat, name: w.name, days: days, parents: val('parents'), phones: val('phones'),
                emails: val('emails'), note: $('note').value, code: val('code') };
    var b = $('reviewBody'); b.innerHTML = '';
    [['班級座號', w.cls + ' ' + w.seat + '號'], ['學生姓名', w.name],
     ['自習天數', info.days.filter(function (d) { return daySel[d.n]; }).map(function (d) { return d.label; }).join('、')],
     ['家長姓名', pending.parents], ['聯絡電話', pending.phones], ['Email', pending.emails], ['備註', pending.note || '(無)'],
     ['驗證碼', pending.code ? '已填寫(修改或異動)' : '(新報名,送出後取得)']].forEach(function (x) {
      var row = el('div', 'row'); row.appendChild(el('div', 'b', x[0])); row.appendChild(el('div', 'a', x[1])); b.appendChild(row);
    });
    $('formCard').hidden = true; $('reviewCard').hidden = false; window.scrollTo(0, 0);
  });
  $('backBtn').addEventListener('click', function () { $('reviewCard').hidden = true; $('formCard').hidden = false; window.scrollTo(0, 0); });
  $('confirmBtn').addEventListener('click', function () {
    clearBanner();
    var w = who();
    run(pending, function (res) {
      if (!res.ok) { $('reviewCard').hidden = true; $('formCard').hidden = false; showBanner('error', res.msg); return; }
      showDone(res.mode === 'new' ? '報名資料已送出' : (res.queued ? '申請已收到' : '資料已更新'), res, w);
    });
  });

  twoStep($('withdrawBtn'), '全部退選(退出自習)', '確定要退出自習?再按一次', function () {
    clearBanner();
    var w = who();
    if (!w.cls || !w.seat || !w.name || !val('code')) { showBanner('error', '退出自習需要班級、座號、姓名和驗證碼。'); return; }
    run({ action: 'signup_withdraw', cls: w.cls, seat: w.seat, name: w.name, code: val('code') }, function (res) {
      if (!res.ok) { showBanner('error', res.msg); return; }
      showDone('全部退選', { message: res.message }, w);
    });
  });

  $('againBtn').addEventListener('click', function () {
    ['cls', 'seat', 'name', 'parents', 'phones', 'emails', 'note', 'code'].forEach(function (id) { $(id).value = ''; });
    setDays([]); clearBanner();
    $('doneCard').hidden = true; $('reviewCard').hidden = true; $('rulesCard').hidden = false; $('formCard').hidden = false; window.scrollTo(0, 0);
  });

})();
</script>
</body>
</html>
